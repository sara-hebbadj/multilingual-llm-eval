# Variable names only. Real values go in "Portfolio Projects/.env" (two folders up),
# or in a local .env next to this file after a fresh clone. Never commit a .env file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model IDs (provider/model). Check current IDs at https://openrouter.ai/models.
# Compare models from different families (e.g. Anthropic, OpenAI, Qwen or DeepSeek), and pick
# MODEL_JUDGE from yet another family (e.g. Google): the runner refuses a same-family judge.
MODEL_MAIN=
MODEL_CHEAP=
MODEL_JUDGE=
# Budget guard (US$)
MAX_COST_PER_RUN_USD=3
MAX_COST_PER_PROJECT_USD=10
